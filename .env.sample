# Network: localtestnet, testnet, or mainnet
NETWORK=testnet

# NoxRegistry contract address
REGISTRY_ADDRESS=0x...

# Ethereum JSON-RPC URL(s), comma-separated for failover, most generous first
# (defaults to localhost:8545 for localtestnet)
ETH_RPC_URL=https://primary.example/rpc,https://fallback.example/rpc

# Refuse to sync unless the RPC reports this chain id (421614 = Arbitrum Sepolia)
# EXPECTED_CHAIN_ID=421614

# Blocks behind head treated as final (default 0 on localtestnet, 20 otherwise)
# CHAIN_CONFIRMATIONS=20

# eth_getLogs block range: initial size and bounds (adapts to provider limits)
# LOG_CHUNK_SIZE=50000
# LOG_CHUNK_MIN=500
# LOG_CHUNK_MAX=1000000

# NoxRegistry deployment block: where a full replay starts for a registry with no checkpoint
FROM_BLOCK=0

# PostgreSQL connection string (auto-injected on Railway)
DATABASE_URL=postgres://postgres:password@localhost:5432/indexer

# HTTP server port
PORT=4000

# Seconds between uptime reputation checks
UPTIME_CHECK_INTERVAL=60

# Path to MaxMind GeoLite2-City.mmdb for IP geolocation (optional)
GEOIP_DB_PATH=/assets/GeoLite2-City.mmdb
