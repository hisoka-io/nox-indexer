# Network: localtestnet, testnet, or mainnet
NETWORK=testnet

# NoxRegistry contract address
REGISTRY_ADDRESS=0x...

# Ethereum JSON-RPC URL (defaults to localhost:8545 for localtestnet)
ETH_RPC_URL=https://...

# Block number to start scanning events from (use contract deployment block to avoid scanning from genesis)
FROM_BLOCK=0

# PostgreSQL connection string (auto-injected on Railway)
DATABASE_URL=postgres://postgres:password@localhost:5432/indexer

# HTTP server port
PORT=4000

# Seconds between uptime reputation checks
UPTIME_CHECK_INTERVAL=60

# Path to MaxMind GeoLite2-City.mmdb for IP geolocation (optional)
GEOIP_DB_PATH=/assets/GeoLite2-City.mmdb
