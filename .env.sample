# Network: localtestnet, testnet, or mainnet
NETWORK=testnet

# NoxRegistry contract address (live Arbitrum Sepolia registry)
REGISTRY_ADDRESS=0xF7BFf88A1412054a001Dc4b8aCBddAd6F9b26cB6

# Ethereum JSON-RPC URL(s), comma-separated for failover, most generous first
# (defaults to localhost:8545 for localtestnet)
ETH_RPC_URL=https://primary.example/rpc,https://fallback.example/rpc

# Refuse to sync unless the RPC reports this chain id (421614 = Arbitrum Sepolia)
EXPECTED_CHAIN_ID=421614

# Blocks behind head treated as final (default 0 on localtestnet, 20 otherwise)
# CHAIN_CONFIRMATIONS=20

# eth_getLogs block range: initial size and bounds (adapts to provider limits)
# LOG_CHUNK_SIZE=50000
# LOG_CHUNK_MIN=500
# LOG_CHUNK_MAX=1000000

# NoxRegistry deployment block: where a full replay starts for a registry with no checkpoint.
# Must be set; 0 is rejected. 312414608 is the live Arbitrum Sepolia registry.
FROM_BLOCK=312414608

# Paid execution settlements (optional). Unset ENTRY_POINT_ADDRESS turns indexing off.
# ENTRY_POINT_ADDRESS=0xad911Ca217C6dC779fCE6A6538bDda3071c38E7E
# REWARD_POOL_ADDRESS=0xA487BAa4f2C3fAA01C70066EE88b6F7fD6f1361D
# SETTLEMENT_FROM_BLOCK=312414608

# PostgreSQL connection string (auto-injected on Railway)
DATABASE_URL=postgres://postgres:password@localhost:5432/indexer

# HTTP server port
PORT=4000

# Seconds between uptime reputation checks
UPTIME_CHECK_INTERVAL=60

# Seconds without a caught-up chain poll before /healthz/sync returns 503
# HEALTH_MAX_SYNC_AGE_SECS=300

# Seconds between reads of each node's /topology for its PoW difficulty
# NODE_TOPOLOGY_POLL_SECS=60

# Ceiling on the pow_difficulty published in /seed/topology
# SEED_MAX_POW_DIFFICULTY=16

# Poll loopback/private node addresses (always allowed on localtestnet)
# ALLOW_PRIVATE_NODE_ADDRESSES=false

# Log filter (default info), e.g. info,indexer=debug
# RUST_LOG=info

# Path to MaxMind GeoLite2-City.mmdb for IP geolocation (optional)
GEOIP_DB_PATH=/assets/GeoLite2-City.mmdb
